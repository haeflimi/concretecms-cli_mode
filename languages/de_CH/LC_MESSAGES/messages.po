#, php-format
msgid "Welcome back, %s."
msgstr "Willkommen zurück, %s."

#: cli_mode/src/Terminal/Welcome.php:52
msgid "Your last command was probably a mistake."
msgstr "Dein letzter Befehl war vermutlich ein Fehler."

#: cli_mode/src/Terminal/Welcome.php:54
msgid "guest"
msgstr "Gast"

#: cli_mode/src/Terminal/Welcome.php:54
#, php-format
msgid "Welcome, %s."
msgstr "Willkommen, %s."

#: cli_mode/src/Terminal/Welcome.php:54
#, php-format
msgid "Rank: nobody. Type %s to fix that."
msgstr "Rang: niemand. Tippe %s, um das zu ändern."

#: cli_mode/src/Terminal/Welcome.php:56
#, php-format
msgid "Type %1$s for commands, %2$s for the tour."
msgstr "Tippe %1$s für die Befehle, %2$s für die Tour."

#: cli_mode/src/Terminal/Welcome.php:56
msgid "Or just mash keys. I'm used to it."
msgstr "Oder hau einfach wahllos in die Tasten. Ich bin das gewohnt."

#: cli_mode/src/Terminal/Welcome.php:58
msgid "This terminal is mandatory on this site. The mouse is decorative."
msgstr ""
"Dieses Terminal ist auf dieser Website Pflicht. Die Maus ist reine Deko."

#: cli_mode/src/Terminal/Welcome.php:58
msgid "This terminal is the only way to browse this site."
msgstr "Dieses Terminal ist der einzige Weg durch diese Website."

