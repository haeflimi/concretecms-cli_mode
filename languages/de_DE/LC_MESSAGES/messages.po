#: src/Command/Builtin.php:237
msgid "Defines or lists aliases: alias ll=\"ls -l\""
msgstr "Definiert oder listet Aliasse: alias ll=\"ls -l\""

#: src/Command/Builtin.php:249
#, php-format
msgid "alias: %s: not found"
