#: src/Command/Builtin.php:207
msgid "The current date and time"
msgstr "Das aktuelle Datum und die Uhrzeit"

#: src/Command/Builtin.php:212
msgid "How long this session has been running"
msgstr "Wie lange diese Sitzung schon läuft"

#: src/Command/Builtin.php:214
#, php-format
msgid " %s up %d min, 1 user, load average: 0.%02d, 0.%02d, 0.%02d"
msgstr " %s up %d min, 1 Benutzer, Durchschnittslast: 0,%02d, 0,%02d, 0,%02d"

#: src/Command/Builtin.php:218
